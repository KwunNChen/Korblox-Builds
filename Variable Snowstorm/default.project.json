{
  "name": "KorbloxSnowstorm",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "Weather": {
        "$path": "src/shared"
      },

      "WeatherState": {
        "$className": "Configuration",
        "$attributes": {
          "Intensity": 0,
          "Phase": "Clear",
          "WindX": 0,
          "WindZ": 0,
          "InstantCue": 0,
          "PhaseSecondsLeft": 0,
          "ThunderActive": false
        }
      },

      "ThunderStrike": {
        "$className": "RemoteEvent"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",

      "Weather": {
        "$path": "src/server"
      },

      "Common": {
        "$path": "src/server-common"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",

        "Weather": {
          "$path": "src/client"
        }
      }
    }
  }
}
