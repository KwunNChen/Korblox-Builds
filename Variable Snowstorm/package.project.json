{
  "name": "VariableSnowstorm",
  "tree": {
    "$className": "Folder",

    "README": {
      "$path": "src/package/README.luau"
    },

    "ReplicatedStorage": {
      "$className": "Folder",

      "Weather": {
        "$path": "src/shared"
      },

      "WeatherState": {
        "$className": "Configuration",
        "$attributes": {
          "Intensity": 0,
          "Phase": "Clear",
          "WindX": 0,
          "WindZ": 0,
          "InstantCue": 0,
          "PhaseSecondsLeft": 0
        }
      }
    },

    "ServerScriptService": {
      "$className": "Folder",

      "Weather": {
        "$path": "src/server"
      },

      "Common": {
        "$path": "src/server-common"
      }
    },

    "StarterPlayerScripts": {
      "$className": "Folder",

      "Weather": {
        "$path": "src/client"
      }
    }
  }
}
